# ─── Database Configuration (Google Cloud SQL) ──────────────────────
# Replace with your Cloud SQL instance details
POSTGRES_USER=your_cloud_sql_user
POSTGRES_PASSWORD=your_cloud_sql_password
POSTGRES_DB=career_db
POSTGRES_PORT=5432
POSTGRES_SERVER=your_cloud_sql_ip_or_hostname

# ─── Application URLs ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
LANGGRAPH_CHECKPOINT_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── Neo4j AuraDB Configuration ─────────────────────────────────────
# Replace with your AuraDB connection details
NEO4J_URI=neo4j+s://your_auradb_id.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_auradb_password


# ─── External API Keys (REQUIRED) ───────────────────────────────────
# Get your Gemini API Key from: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# (Optional) For specialized Google GenAI features
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=False

# ─── Authentication (OAuth) ─────────────────────────────────────────
# Get LinkedIn credentials from: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Get Google OAuth credentials from: https://console.cloud.google.com/
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret

# ─── Security ───────────────────────────────────────────────────────
# Generate a secret key with: openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SECRET_KEY=your_random_secret_key_here

# ─── Payments (Stripe) ──────────────────────────────────────────────
# Get your keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxx
STRIPE_PREMIUM_PRICE_ID=price_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Email (SMTP) ───────────────────────────────────────────────────
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_specific_password

# ─── Scraping & Search ──────────────────────────────────────────────
# Optional: For LinkedIn scraping features
APIFY_API_TOKEN=your_apify_token

# ─── Frontend Configuration ─────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
