# ─── Database Configuration ─────────────────────────────────────────
# These defaults work with the provided docker-compose.yml
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=career_db
POSTGRES_PORT=5432
POSTGRES_SERVER=db

# ─── Application URLs (Internal Docker Networking) ──────────────────
# Use 'db' as the hostname when running via Docker Compose
DATABASE_URL=postgresql+asyncpg://admin:password123@db:5432/career_db
LANGGRAPH_CHECKPOINT_URL=postgresql://admin:password123@db:5432/career_db
NEO4J_URI=bolt://neo4j:7687

# ─── External API Keys (REQUIRED) ───────────────────────────────────
# Get your Gemini API Key from: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# (Optional) For specialized Google GenAI features
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=False

# ─── Authentication (OAuth) ─────────────────────────────────────────
# Get LinkedIn credentials from: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Get Google OAuth credentials from: https://console.cloud.google.com/
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret

# ─── Security ───────────────────────────────────────────────────────
# Generate a secret key with: openssl rand -hex 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SECRET_KEY=your_random_secret_key_here

# ─── Payments (Stripe) ──────────────────────────────────────────────
# Get your keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxx
STRIPE_PREMIUM_PRICE_ID=price_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Email (SMTP) ───────────────────────────────────────────────────
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_specific_password

# ─── Scraping & Search ──────────────────────────────────────────────
# Optional: For LinkedIn scraping features
APIFY_API_TOKEN=your_apify_token

# ─── Frontend Configuration ─────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
